{
  "servidores": [
    {
      "nombre": "principal",
      "lector": "local"
    },
    {
      "nombre": "hoja-1",
      "lector": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "hoja-1",
        "python3",
        "-"
      ]
    }
  ],
  "propias": [
    "propio/"
  ],
  "por_defecto": {
    "nivel": "nunca",
    "expuesto": false
  },
  "componentes": {
    "docker.io/library/postgres": {
      "nivel": "patch",
      "playbook": "datos"
    },
    "docker.io/library/odoo": {
      "nivel": "nunca",
      "expuesto": true,
      "nota": "se ensaya en la copia de pruebas"
    },
    "docker.io/ejemplo/tunel": {
      "nivel": "patch",
      "expuesto": true,
      "linea": 1,
      "playbook": "imagen"
    },
    "docker.io/propio/bot": {
      "base": "python:3.13-slim",
      "nivel": "patch",
      "playbook": "propia"
    },
    "sistema": {
      "nivel": "patch",
      "playbook": "reinicio"
    }
  },
  "maduracion_dias": 7,
  "plazos_h": {
    "kev_expuesto": 24,
    "alta_expuesta": 72,
    "alta_interna": 168,
    "ordinario": 720
  },
  "fuentes": {
    "docker_hub": true,
    "registros": [
      "registro.ejemplo.test"
    ],
    "kev": true,
    "destinos": [
      "auth.registro.ejemplo.test",
      "capas.registro.ejemplo.test"
    ]
  },
  "escaner": {
    "comando": [
      "trivy",
      "image",
      "--quiet",
      "--format",
      "json"
    ],
    "tope_s": 2700
  },
  "estado_dir": "/var/lib/vigia",
  "registro_dir": "/var/lib/vigia/registro",
  "foto_vigencia_s": 900,
  "ventana": {
    "dias": [
      1
    ],
    "desde": "02:00",
    "hasta": "05:00"
  },
  "playbooks": [
    "imagen",
    "datos",
    "propia",
    "reinicio"
  ],
  "acciones": {
    "principal": {
      "respaldo_vigente": [
        "/usr/local/sbin/vigia-accion",
        "respaldo-vigente"
      ],
      "aplicar_imagen": [
        "/usr/local/sbin/vigia-accion",
        "aplicar-imagen",
        "{proyecto}/{servicio}",
        "{referencia}"
      ],
      "verificar": [
        "/usr/local/sbin/vigia-accion",
        "verificar",
        "{proyecto}/{servicio}"
      ],
      "volver_imagen": [
        "/usr/local/sbin/vigia-accion",
        "volver-imagen",
        "{proyecto}/{servicio}",
        "{referencia}"
      ],
      "respaldar_datos": [
        "/usr/local/sbin/vigia-accion",
        "respaldar-datos",
        "{proyecto}/{servicio}",
        "{marca}"
      ],
      "restaurar_datos": [
        "/usr/local/sbin/vigia-accion",
        "restaurar-datos",
        "{proyecto}/{servicio}",
        "{marca}"
      ],
      "construir_propia": [
        "/usr/local/sbin/vigia-accion",
        "construir-propia",
        "{proyecto}/{servicio}",
        "{base}"
      ],
      "aplicar_propia": [
        "/usr/local/sbin/vigia-accion",
        "aplicar-propia",
        "{proyecto}/{servicio}",
        "{base}"
      ],
      "volver_propia": [
        "/usr/local/sbin/vigia-accion",
        "volver-propia",
        "{proyecto}/{servicio}",
        "{base}"
      ],
      "reiniciar": [
        "/usr/local/sbin/vigia-accion",
        "reiniciar"
      ],
      "verificar_servidor": [
        "/usr/local/sbin/vigia-accion",
        "verificar-servidor"
      ]
    }
  },
  "max_por_ventana": 3,
  "espera_salud_s": 180,
  "aviso": [
    "/usr/local/sbin/vigia-aviso"
  ],
  "ventana_urgente": {
    "desde": "03:00",
    "hasta": "05:00"
  },
  "espera_reinicio_s": 1200,
  "sistema_plazo_h": 72,
  "pausa_max_dias": 7,
  "maquinas": {
    "archivo": "/var/lib/vigia/maquinas.json",
    "vigencia_s": 3600,
    "esperadas": {
      "vm-principal": {
        "servidor": "principal"
      },
      "vm-hoja-1": {
        "servidor": "hoja-1"
      },
      "vm-pruebas": {
        "apagada": true
      },
      "vm-controlador": {
        "sin_vigia": true
      }
    }
  },
  "repos": [
    {
      "nombre": "addons-ejemplo",
      "servidor": "principal",
      "local": [
        "git",
        "-C",
        "/srv/odoo/addons/ejemplo",
        "rev-parse",
        "HEAD"
      ],
      "remoto": "https://forja.ejemplo.test/addons/ejemplo.git",
      "rama": "18.0"
    }
  ]
}
